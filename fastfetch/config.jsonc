{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/blitzart.txt",
    "type": "auto",
    "color": {
      "1": "38;2;46;196;230",
      "3": "38;2;224;17;43"
    },
    "height": 30,
    "width": 38,
    "padding": {
      "left": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": "├ PC",
      "keyColor": "red",
      "format": ""
    },
    {
      "type": "cpu",
      "key": "│ ├ CPU",
      "showPeCoreCount": true,
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮 GPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "│ ├ MEM",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "│ └ DISK",
      "keyColor": "red",
      "format": "{1} / {2} ({3}) - {9}"
    },
    {
      "type": "custom",
      "format": "\u001b[31m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "├󰣇 OS",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 PKGS",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": "│ ├ Termial",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "│ └ Shell",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[31m│"
    },
    {
      "type": "de",
      "key": "├󰹑 DE",
      "keyColor": "red"
    },
    {
      "type": "lm",
      "key": "│ ├󰍂 LM",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "│ ├󱇜 WM",
      "keyColor": "red"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼 WMtheme",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "key": "│ ├ Font",
      "keyColor": "red",
      "format": "Victor Mono Bold"
    },
    {
      "type": "cursor",
      "key": "│ └󰆿 Cursor",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[31m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m┌───────────────────Miscellaneous────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "text": "battery",
      "shell": "/opt/homebrew/bin/fish",
      "key": "  Battery",
      "keyColor": "blue"
    },
    {
      "type": "media",
      "key": "  Music",
      "keyColor": "blue",
      "format": "{2}"
    },
    {
      "type": "datetime",
      "key": "  Date and Time",
      "keyColor": "blue",
      "format": "{3}/{11}/{1} - {14}:{18} {22}"
    },
    {
      "type": "custom",
      "format": "  'Arch is good for servers' - Tobianime Szymański",
      "outputColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[34m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 20,
      "symbol": "square"
    },
    "break"
  ]
}
